[Desktop Entry]
Type=Application
Name=Scarlett
GenericName=Music Player
Comment=Play your Spotify library
Exec=scarlett
Icon=scarlett
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=spotify;music;player;lyrics;
StartupWMClass=scarlett
SingleMainWindow=true
Actions=Immersive;PlayPause;

[Desktop Action Immersive]
Name=Open Immersive Player
Exec=scarlett --immersive

[Desktop Action PlayPause]
Name=Play or Pause
Exec=scarlett --play-pause
